-- ========================================================
-- FCY INJETADO VIA CSP (Direção de Prova)
-- ========================================================

local ADMIN_STEAM_ID = "76561198091832668"

local FCY = false
local showUI = true
local countdownTimer = 0
local secondTracker = 0
local tempoSlider = 5

-- Leitura segura de structs C (evita o crash de membro inexistente)
local function safeRead(cdataObj, key)
    if not cdataObj then return nil end
    local ok, value = pcall(function() return cdataObj[key] end)
    return ok and value or nil
end

-- Valida se o usuário atual é o comissário/diretor
local function isDirector()
    local car = ac.getCar(0)
    local sim = ac.getSim()

    -- 1. Se estiver em Single Player / Prática Offline, libera sempre
    if sim and not sim.isOnlineRace then
        return true
    end

    -- 2. Tenta ler o GUID/SteamID na struct do carro ou simulação
    local playerGuid = tostring(safeRead(car, "guid") or safeRead(sim, "userGuid") or "")
    if playerGuid == ADMIN_STEAM_ID then
        return true
    end

    return false
end

-- Comunicação de rede CSP
local comms
comms = ac.OnlineEvent({
    ac.StructItem.key("CSP_FCY_NET"),
    fcy = ac.StructItem.boolean(),
    timer = ac.StructItem.uint8(),
    req = ac.StructItem.boolean()
}, function(sender, message)
    if message.req then
        if FCY and isDirector() then
            comms({ fcy = true, timer = 0, req = false })
        end
        return
    end

    FCY = message.fcy
    if FCY then
        countdownTimer = message.timer
        if countdownTimer == 0 then
            ac.playUISound(ac.UISound.FlagCaution)
            ac.setMessage("DIREÇÃO DE PROVA", "FULL COURSE YELLOW ATIVADO", nil, 5)
        else
            ac.playUISound(ac.UISound.Notification)
            ac.setMessage("DIREÇÃO DE PROVA", string.format("FCY EM %d SEGUNDOS", countdownTimer), nil, 1)
        end
    else
        countdownTimer = 0
        physics.overrideRacingFlag(ac.FlagType.None)
        ac.setTurningLights(ac.TurningLights.None)
        ac.playUISound(ac.UISound.FlagGreen)
        ac.setMessage("DIREÇÃO DE PROVA", "PISTA LIBERADA - BANDEIRA VERDE", nil, 4)
    end
end, ac.SharedNamespace.Track)

-- Interface gráfica desenhada diretamente na tela
function script.drawUI()
    if not isDirector() or not showUI then return end

    ui.beginTransparentWindow("FCY_Admin", vec2(40, 120), vec2(250, 150))
    ui.text("Direção de Prova - FCY")
    ui.separator()

    tempoSlider = ui.slider("##time", tempoSlider, 0, 10, "Contagem: %.0f s")

    local btnText = FCY and "LIBERAR (GREEN)" or "ACIONAR (DEPLOY)"
    if ui.button(btnText, vec2(-1, 35)) then
        local novo = not FCY
        local t = novo and math.floor(tempoSlider) or 0

        -- Aplica localmente na máquina do diretor de imediato
        FCY = novo
        if novo then
            countdownTimer = t
            if t == 0 then
                ac.playUISound(ac.UISound.FlagCaution)
                ac.setMessage("DIREÇÃO DE PROVA", "FULL COURSE YELLOW ATIVADO", nil, 5)
            end
        else
            countdownTimer = 0
            physics.overrideRacingFlag(ac.FlagType.None)
            ac.setTurningLights(ac.TurningLights.None)
            ac.playUISound(ac.UISound.FlagGreen)
            ac.setMessage("DIREÇÃO DE PROVA", "PISTA LIBERADA - BANDEIRA VERDE", nil, 4)
        end

        -- Transmite a ordem pela rede para todos os outros pilotos
        comms({ fcy = novo, timer = t, req = false })
    end

    ui.dummy(vec2(0, 3))
    if FCY then
        ui.textColored("STATUS: FCY ATIVO (MAX 80 KM/H)", rgbm(1, 0.8, 0, 1))
    elseif countdownTimer > 0 then
        ui.textColored(string.format("STATUS: FCY EM %d s...", countdownTimer), rgbm(1, 0.5, 0, 1))
    else
        ui.textColored("STATUS: BANDEIRA VERDE", rgbm(0, 1, 0, 1))
    end

    ui.endTransparentWindow()
end

function script.update(dt)
    -- Alterna exibição do painel apertando F8 no teclado
    if ui.keyboardButtonDown(ui.Key.F8) then
        showUI = not showUI
    end

    -- Gerenciador da contagem regressiva
    if countdownTimer > 0 then
        secondTracker = secondTracker + dt
        if secondTracker >= 1.0 then
            secondTracker = secondTracker - 1.0
            countdownTimer = countdownTimer - 1
            if countdownTimer > 0 then
                ac.playUISound(ac.UISound.Notification)
                ac.setMessage("DIREÇÃO DE PROVA", string.format("FCY EM %d SEGUNDOS", countdownTimer), nil, 1)
            else
                FCY = true
                ac.playUISound(ac.UISound.FlagCaution)
                ac.setMessage("DIREÇÃO DE PROVA", "FULL COURSE YELLOW ATIVADO", nil, 5)
            end
        end
    end

    -- Regras físicas ativas durante o FCY
    if FCY then
        physics.overrideRacingFlag(ac.FlagType.Caution)
        ac.setTurningLights(ac.TurningLights.Hazards)

        local vel = ac.getCar(0).speedKmh
        if vel > 80 then
            physics.forceUserThrottleFor(dt, 0)
            if vel > 85 and physics.getCarInputControls().brake < 0.1 then
                physics.setGentleStop(0, true)
            else
                physics.setGentleStop(0, false)
            end
        else
            physics.setGentleStop(0, false)
        end
    end
end

-- Sincronização inicial
comms({ req = true })