-- ========================================================
-- FCY INJETADO VIA CSP (SCRIPT_1) - TOTALMENTE INSTRUMENTADO
-- ========================================================

ac.log(">>> [FCY INIT] SCRIPT_1 carregado com sucesso <<<")

local FCY = false
local showUI = true
local countdownTimer = 0
local secondTracker = 0
local tempoSlider = 5

-- Travas de log para nao floodar o arquivo durante a fisica
local logLimiterActive = false
local logGentleStopActive = false

-- Depuracao em tela (Lua Debug)
local drawUICalls = 0
local updateCalls = 0

-- Funcao central de mudanca de estado
local function aplicarEstadoFCY(ativo, tempo, origem)
    ac.log(string.format(">>> [FCY STATE] aplicarEstadoFCY chamado por [%s] | ativo=%s, tempo=%s", 
        tostring(origem), tostring(ativo), tostring(tempo)))

    if ativo then
        countdownTimer = tempo or 0
        if countdownTimer == 0 then
            FCY = true
            ac.log(">>> [FCY STATE] FCY IMEDIATO ATIVADO (Bandeira Amarela)")
            ac.playUISound(ac.UISound.FlagCaution)
            ac.setMessage("DIREÇÃO DE PROVA", "FULL COURSE YELLOW ATIVADO", nil, 5)
        else
            ac.log(string.format(">>> [FCY STATE] CONTAGEM INICIADA (%d segundos)", countdownTimer))
            ac.playUISound(ac.UISound.Notification)
            ac.setMessage("DIREÇÃO DE PROVA", string.format("FCY EM %d SEGUNDOS", countdownTimer), nil, 1)
        end
    else
        FCY = false
        countdownTimer = 0
        physics.overrideRacingFlag(ac.FlagType.None)
        ac.setTurningLights(ac.TurningLights.None)
        ac.playUISound(ac.UISound.FlagGreen)
        ac.setMessage("DIREÇÃO DE PROVA", "PISTA LIBERADA - BANDEIRA VERDE", nil, 4)
        ac.log(">>> [FCY STATE] PISTA LIBERADA (Bandeira Verde e luzes desligadas)")
    end
end

-- Canal de rede
local comms
comms = ac.OnlineEvent({
    ac.StructItem.key("CSP_FCY_NET"),
    fcy = ac.StructItem.boolean(),
    timer = ac.StructItem.uint8(),
    req = ac.StructItem.boolean()
}, function(sender, message)
    ac.log(string.format(">>> [FCY NET RECV] Mensagem recebida de [%s]: fcy=%s, timer=%s, req=%s", 
        tostring(sender), tostring(message.fcy), tostring(message.timer), tostring(message.req)))

    if message.req then
        ac.log(">>> [FCY NET RECV] Piloto solicitou sincronizacao de estado atual")
        if FCY then
            ac.log(">>> [FCY NET SEND] Respondendo estado ativo para novo piloto")
            comms({ fcy = true, timer = 0, req = false })
        end
        return
    end

    aplicarEstadoFCY(message.fcy, message.timer, "REDE_CLIENTE")
end, ac.SharedNamespace.Track)

-- Renderizacao da interface
function script.drawUI()
    drawUICalls = drawUICalls + 1
    ac.debug("FCY_drawUI_Calls", drawUICalls)

    if not showUI then
        ac.debug("FCY_UI_Status", "Oculto (F8 para abrir)")
        return
    end

    ac.debug("FCY_UI_Status", "Visivel")

    local winPos = vec2(40, 120)
    local winSize = vec2(260, 160)

    -- Fundo escuro solido com borda arredondada
    pcall(function()
        ui.drawRectFilled(winPos, winPos + winSize, rgbm(0.08, 0.08, 0.08, 0.94), 6)
        ui.drawRect(winPos, winPos + winSize, rgbm(0.35, 0.35, 0.35, 1.0), 6)
    end)

    -- IMPORTANTE: O 5º parametro de ui.beginTransparentWindow é 'inputs'.
    -- Por padrao ele é 'false' (janela nao-interativa / click-through).
    -- Passando 'true', os botoes, sliders e cliques do mouse passam a funcionar!
    ui.beginTransparentWindow("FCY_Admin", winPos, winSize, false, true)

    -- Garante foco do mouse sobre a janela para nao interferir na camera/direcao do AC
    if ui.windowHovered() then
        ui.captureMouse(true)
        ui.setMouseCursor(ui.MouseCursor.Arrow)
    end

    ui.text("Direção de Prova - FCY")
    ui.separator()

    ui.setNextItemWidth(-1)
    tempoSlider = ui.slider("##time", tempoSlider, 0, 10, "Contagem: %.0f s")

    local btnText = FCY and "LIBERAR (GREEN)" or "ACIONAR (DEPLOY)"
    if ui.button(btnText, vec2(-1, 35)) then
        local novo = not FCY
        local t = novo and math.floor(tempoSlider) or 0
        ac.log(string.format(">>> [FCY UI CLICK] Botao clicado! Mudando para: %s (tempo: %d s)", tostring(novo), t))

        -- Aplica localmente
        aplicarEstadoFCY(novo, t, "BOTAO_LOCAL")

        -- Dispara para a rede
        ac.log(">>> [FCY NET SEND] Disparando pacote de atualizacao para o grid")
        comms({ fcy = novo, timer = t, req = false })
    end

    ui.dummy(vec2(0, 4))
    if FCY then
        ui.textColored("STATUS: FCY ATIVO (MAX 80)", rgbm(1, 0.8, 0, 1))
    elseif countdownTimer > 0 then
        ui.textColored(string.format("STATUS: EM %d s...", countdownTimer), rgbm(1, 0.5, 0, 1))
    else
        ui.textColored("STATUS: PISTA VERDE", rgbm(0, 1, 0, 1))
    end

    ui.endTransparentWindow()
end

-- Loop de fisica e atualizacao
function script.update(dt)
    updateCalls = updateCalls + 1
    ac.debug("FCY_update_Calls", updateCalls)
    ac.debug("FCY_Velocidade", string.format("%.1f km/h", ac.getCar(0).speedKmh))

    -- Alternar visibilidade do painel via F8
    if ui.keyboardButtonDown(ui.Key.F8) then
        showUI = not showUI
        ac.log(">>> [FCY KEY] Tecla F8 pressionada. Painel showUI=" .. tostring(showUI))
    end

    -- Atalho de teclado rápido via F9 (acionar / liberar sem precisar do mouse)
    if ui.keyboardButtonDown(ui.Key.F9) then
        local novo = not FCY
        local t = novo and math.floor(tempoSlider) or 0
        ac.log(string.format(">>> [FCY KEY F9] Tecla F9 pressionada! Mudando para: %s (tempo: %d s)", tostring(novo), t))
        aplicarEstadoFCY(novo, t, "TECLA_F9")
        comms({ fcy = novo, timer = t, req = false })
    end

    -- Contagem regressiva
    if countdownTimer > 0 then
        secondTracker = secondTracker + dt
        if secondTracker >= 1.0 then
            secondTracker = secondTracker - 1.0
            countdownTimer = countdownTimer - 1
            ac.log(string.format(">>> [FCY TIMER TICK] Restam %d segundos", countdownTimer))

            if countdownTimer > 0 then
                ac.playUISound(ac.UISound.Notification)
                ac.setMessage("DIREÇÃO DE PROVA", string.format("FCY EM %d SEGUNDOS", countdownTimer), nil, 1)
            else
                FCY = true
                ac.log(">>> [FCY TIMER] Contagem finalizada! Ativando FCY pleno e limite de 80 km/h")
                ac.playUISound(ac.UISound.FlagCaution)
                ac.setMessage("DIREÇÃO DE PROVA", "FULL COURSE YELLOW ATIVADO", nil, 5)
            end
        end
    end

    -- Regras fisicas e limitador
    if FCY then
        physics.overrideRacingFlag(ac.FlagType.Caution)
        ac.setTurningLights(ac.TurningLights.Hazards)

        local vel = ac.getCar(0).speedKmh
        if vel > 80 then
            physics.forceUserThrottleFor(dt, 0)
            if not logLimiterActive then
                ac.log(string.format(">>> [FCY PHYSICS] Carro acima de 80 km/h (%.1f km/h). Throttle cortado!", vel))
                logLimiterActive = true
            end

            if vel > 85 and physics.getCarInputControls().brake < 0.1 then
                physics.setGentleStop(0, true)
                if not logGentleStopActive then
                    ac.log(string.format(">>> [FCY PHYSICS] Carro acima de 85 km/h (%.1f km/h). Freio automatico acionado!", vel))
                    logGentleStopActive = true
                end
            else
                physics.setGentleStop(0, false)
                logGentleStopActive = false
            end
        else
            physics.setGentleStop(0, false)
            if logLimiterActive then
                ac.log(string.format(">>> [FCY PHYSICS] Carro abaixo de 80 km/h (%.1f km/h). Throttle restaurado.", vel))
                logLimiterActive = false
            end
            logGentleStopActive = false
        end
    else
        logLimiterActive = false
        logGentleStopActive = false
    end
end

-- Requisicao inicial de sincronizacao
ac.log(">>> [FCY INIT] Enviando requisicao de sincronizacao inicial de grid")
comms({ req = true })
