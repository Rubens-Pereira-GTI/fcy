-- ========================================================
-- FCY INJETADO VIA CSP (Track Script / Server Injection)
-- ========================================================

local ADMIN_STEAM_ID = "76561198091832668 " -- Insira o seu SteamID64 aqui

local isDirector = (ac.getDriverSteamID(0) == ADMIN_STEAM_ID)
local FCY = false
local countdownTimer = 0
local secondTracker = 0
local tempoSlider = 5

-- Canal de rede sincronizado no namespace da pista
local comms
comms = ac.OnlineEvent({
    ac.StructItem.key("CSP_FCY_NET"),
    fcy = ac.StructItem.boolean(),
    timer = ac.StructItem.uint8(),
    req = ac.StructItem.boolean()
}, function(sender, message)
    if message.req then
        if FCY and isDirector then
            comms({ fcy = true, timer = 0, req = false })
        end
        return
    end

    FCY = message.fcy
    if FCY then
        countdownTimer = message.timer
        if countdownTimer == 0 then
            ac.playUISound(ac.UISound.FlagCaution)
            ac.setMessage("DIRECAO DE PROVA", "FULL COURSE YELLOW ATIVADO", nil, 5)
        else
            ac.playUISound(ac.UISound.Notification)
            ac.setMessage("DIRECAO DE PROVA", string.format("FCY EM %d SEGUNDOS", countdownTimer), nil, 1)
        end
    else
        countdownTimer = 0
        physics.overrideRacingFlag(ac.FlagType.None)
        ac.setTurningLights(ac.TurningLights.None)
        ac.playUISound(ac.UISound.FlagGreen)
        ac.setMessage("DIRECAO DE PROVA", "PISTA LIBERADA - BANDEIRA VERDE", nil, 4)
    end
end, ac.SharedNamespace.Track)

-- Interface: renderizada EXCLUSIVAMENTE na tela do diretor de prova
function script.drawUI()
    if not isDirector then return end

    ui.beginTransparentWindow("FCY_Admin", vec2(20, 100), vec2(220, 130))
    ui.text("Painel Direcao (FCY)")
    ui.separator()

    tempoSlider = ui.slider("##time", tempoSlider, 0, 10, "Contagem: %.0f s")

    local btnText = FCY and "LIBERAR (GREEN)" or "ACIONAR (DEPLOY)"
    if ui.button(btnText, vec2(-1, 35)) then
        local novo = not FCY
        local t = novo and math.floor(tempoSlider) or 0
        comms({ fcy = novo, timer = t, req = false })
    end
    ui.endTransparentWindow()
end

function script.update(dt)
    -- 1. Contagem regressiva
    if countdownTimer > 0 then
        secondTracker = secondTracker + dt
        if secondTracker >= 1.0 then
            secondTracker = secondTracker - 1.0
            countdownTimer = countdownTimer - 1
            if countdownTimer > 0 then
                ac.playUISound(ac.UISound.Notification)
                ac.setMessage("DIRECAO DE PROVA", string.format("FCY EM %d SEGUNDOS", countdownTimer), nil, 1)
            else
                ac.playUISound(ac.UISound.FlagCaution)
                ac.setMessage("DIRECAO DE PROVA", "FULL COURSE YELLOW ATIVADO", nil, 5)
            end
        end
    end

    -- 2. Regras fisicas aplicadas em todos os clientes
    if FCY then
        physics.overrideRacingFlag(ac.FlagType.Caution)
        ac.setTurningLights(ac.TurningLights.Hazards)

        local vel = ac.getCar(0).speedKmh
        if vel > 80 then
            physics.forceUserThrottleFor(dt, 0)
            if vel > 85 and physics.getCarInputControls().brake < 0.1 then
                physics.setGentleStop(0, true)
            else
                physics.setGentleStop(0, false)
            end
        else
            physics.setGentleStop(0, false)
        end
    end
end

-- Sincroniza ao conectar
comms({ req = true })