-- ========================================================
-- CONFIGURAÇÃO DE DIRETORES DE PROVA / ADMINS (OPÇÃO 1)
-- ========================================================
-- Adicione aqui o nome exato dos pilotos que têm permissão de Direção de Prova.
-- Deve ser o mesmo nome configurado no Content Manager / Assetto Corsa.
local admins = {
    ["Rubens .P"] = true,
    ["Diretor de Prova"] = true,
    ["Admin"] = true,
    -- Adicione outros administradores abaixo:
    -- ["Seu Nome"] = true,
}

-- Verifica se o piloto local tem permissão de administrador
local function isLocalAdmin()
    -- Se estiver jogando offline (treino/teste local), libera para testes
    if not ac.getServerIP() or ac.getServerIP() == "" then
        return true
    end

    local myName = ac.getDriverName(0)
    return myName ~= nil and admins[myName] == true
end

local FCY = false
local showUI = true
local countdownTimer = 0
local secondTracker = 0
local tempoSlider = 5

-- Posicao persistente da janela (salva automaticamente pelo CSP no disco)
local storedPos
pcall(function()
    storedPos = ac.storage{ posX = 40, posY = 120 }
end)
if not storedPos then
    storedPos = { posX = 40, posY = 120 }
end

-- Travas de log para nao floodar o arquivo durante a fisica
local logLimiterActive = false
local logGentleStopActive = false

-- Depuracao em tela (Lua Debug)
local drawUICalls = 0
local updateCalls = 0

-- Funcao central de mudanca de estado
local function aplicarEstadoFCY(ativo, tempo, origem)
    ac.log(string.format(">>> [FCY STATE] aplicarEstadoFCY chamado por [%s] | ativo=%s, tempo=%s", 
        tostring(origem), tostring(ativo), tostring(tempo)))

    if ativo then
        countdownTimer = tempo or 0
        if countdownTimer == 0 then
            FCY = true
            ac.log(">>> [FCY STATE] FCY IMEDIATO ATIVADO (Bandeira Amarela)")
            ac.playUISound(ac.UISound.FlagCaution)
            ac.setMessage("DIREÇÃO DE PROVA", "FULL COURSE YELLOW ATIVADO", nil, 5)
        else
            ac.log(string.format(">>> [FCY STATE] CONTAGEM INICIADA (%d segundos)", countdownTimer))
            ac.playUISound(ac.UISound.Notification)
            ac.setMessage("DIREÇÃO DE PROVA", string.format("FCY EM %d SEGUNDOS", countdownTimer), nil, 1)
        end
    else
        FCY = false
        countdownTimer = 0
        physics.overrideRacingFlag(ac.FlagType.None)
        ac.setTurningLights(ac.TurningLights.None)
        ac.playUISound(ac.UISound.FlagGreen)
        ac.setMessage("DIREÇÃO DE PROVA", "PISTA LIBERADA - BANDEIRA VERDE", nil, 4)
        ac.log(">>> [FCY STATE] PISTA LIBERADA (Bandeira Verde e luzes desligadas)")
    end
end

-- Canal de rede
local comms
comms = ac.OnlineEvent({
    ac.StructItem.key("CSP_FCY_NET"),
    fcy = ac.StructItem.boolean(),
    timer = ac.StructItem.uint8(),
    req = ac.StructItem.boolean()
}, function(sender, message)
    ac.log(string.format(">>> [FCY NET RECV] Mensagem recebida de [%s]: fcy=%s, timer=%s, req=%s", 
        tostring(sender), tostring(message.fcy), tostring(message.timer), tostring(message.req)))

    if message.req then
        ac.log(">>> [FCY NET RECV] Piloto solicitou sincronizacao de estado atual")
        -- Apenas administradores respondem requisicoes de sincronizacao de rede
        if FCY and isLocalAdmin() then
            ac.log(">>> [FCY NET SEND] Respondendo estado ativo para novo piloto")
            comms({ fcy = true, timer = 0, req = false })
        end
        return
    end

    -- SEGURANÇA: Quando estiver online, ignora pacotes vindos de jogadores que não são admin
    if sender and ac.getServerIP() and ac.getServerIP() ~= "" then
        local senderCar = sender.index or (type(sender) == "number" and sender)
        local senderName = senderCar and ac.getDriverName(senderCar)
        if not senderName or admins[senderName] ~= true then
            ac.log(string.format(">>> [FCY NET RECV] BLOQUEADO: Comando de FCY rejeitado (enviado por nao-admin: '%s')", tostring(senderName)))
            return
        end
    end

    aplicarEstadoFCY(message.fcy, message.timer, "REDE_CLIENTE")
end, ac.SharedNamespace.Track)

-- Renderizacao da interface
function script.drawUI()
    drawUICalls = drawUICalls + 1
    ac.debug("FCY_drawUI_Calls", drawUICalls)

    -- Apenas administradores veem a moldura de controle
    if not isLocalAdmin() then
        return
    end

    if not showUI then
        ac.debug("FCY_UI_Status", "Oculto (F8 para abrir)")
        return
    end

    ac.debug("FCY_UI_Status", "Visivel")

    local winPos = vec2(storedPos.posX, storedPos.posY)
    local winSize = vec2(260, 160)

    -- Inicia a janela com inputs habilitados (true)
    ui.beginTransparentWindow("FCY_Admin", winPos, winSize, false, true)

    -- Fundo desenhado DENTRO da janela (ordem correta: desenha antes dos controles, ficando atrás deles)
    ui.drawRectFilled(vec2(0, 0), winSize, rgbm(0.10, 0.10, 0.13, 0.94), 8)
    -- Barra de cabeçalho sutil para indicar área arrastável
    ui.drawRectFilled(vec2(0, 0), vec2(winSize.x, 26), rgbm(0.18, 0.20, 0.26, 0.90), 8, ui.CornerFlags.Top)
    ui.drawRect(vec2(0, 0), winSize, rgbm(0.40, 0.40, 0.45, 1.0), 8)

    -- Garante foco do mouse sobre a janela para nao interferir na camera/direcao do AC
    if ui.windowHovered() then
        ui.captureMouse(true)
        ui.setMouseCursor(ui.MouseCursor.Arrow)
    end

    -- Barra de título arrastável (clicar e arrastar move a janela para qualquer lugar)
    local curPos = ui.getCursor()
    ui.invisibleButton("##dragHeader", vec2(winSize.x - 16, 22))

    if ui.itemActive() then
        local delta = ui.mouseDelta()
        if delta.x ~= 0 or delta.y ~= 0 then
            local screenSize = ac.getUI().windowSize
            storedPos.posX = math.clamp(storedPos.posX + delta.x, 0, screenSize.x - winSize.x)
            storedPos.posY = math.clamp(storedPos.posY + delta.y, 0, screenSize.y - winSize.y)
        end
    end

    if ui.itemHovered() then
        ui.setMouseCursor(ui.MouseCursor.ResizeAll)
        ui.setTooltip("Arraste para mover o painel (duplo clique para resetar posição)")
        if ac.getUI().isMouseLeftKeyDoubleClicked then
            storedPos.posX = 40
            storedPos.posY = 120
            ac.log(">>> [FCY UI] Posicao do painel resetada para o padrao (40, 120)")
        end
    end

    -- Desenha o ícone de alça e o título sobre a área arrastável
    ui.setCursor(curPos)
    ui.icon(ui.Icons.Bars, 14, rgbm(0.65, 0.75, 0.85, 1))
    ui.sameLine(0, 6)
    ui.pushFont(ui.Font.Title)
    ui.textColored("Direção de Prova - FCY", rgbm(1, 1, 1, 1))
    ui.popFont()
    ui.separator()

    -- Slider com fundo e pegador de alto contraste
    ui.pushStyleColor(ui.StyleColor.FrameBg, rgbm(0.22, 0.24, 0.28, 1.0))
    ui.pushStyleColor(ui.StyleColor.SliderGrab, rgbm(0.85, 0.88, 0.95, 1.0))
    ui.pushStyleColor(ui.StyleColor.SliderGrabActive, rgbm(1.0, 1.0, 1.0, 1.0))
    ui.pushStyleColor(ui.StyleColor.Text, rgbm(1, 1, 1, 1))
    ui.setNextItemWidth(-1)
    tempoSlider = ui.slider("##time", tempoSlider, 0, 10, "Contagem: %.0f s")
    ui.popStyleColor(4)

    -- Botao com cor dinamica: Vermelho para Acionar, Verde para Liberar
    local btnText = FCY and "LIBERAR (GREEN)" or "ACIONAR (DEPLOY)"
    if FCY then
        ui.pushStyleColor(ui.StyleColor.Button, rgbm(0.18, 0.65, 0.28, 1.0))
        ui.pushStyleColor(ui.StyleColor.ButtonHovered, rgbm(0.22, 0.78, 0.34, 1.0))
        ui.pushStyleColor(ui.StyleColor.ButtonActive, rgbm(0.14, 0.52, 0.22, 1.0))
    else
        ui.pushStyleColor(ui.StyleColor.Button, rgbm(0.80, 0.22, 0.22, 1.0))
        ui.pushStyleColor(ui.StyleColor.ButtonHovered, rgbm(0.92, 0.28, 0.28, 1.0))
        ui.pushStyleColor(ui.StyleColor.ButtonActive, rgbm(0.68, 0.18, 0.18, 1.0))
    end
    ui.pushStyleColor(ui.StyleColor.Text, rgbm(1, 1, 1, 1))

    local btnClicked = ui.button(btnText, vec2(-1, 35))
    ui.popStyleColor(4)

    if btnClicked then
        local novo = not FCY
        local t = novo and math.floor(tempoSlider) or 0
        ac.log(string.format(">>> [FCY UI CLICK] Botao clicado! Mudando para: %s (tempo: %d s)", tostring(novo), t))

        -- Aplica localmente
        aplicarEstadoFCY(novo, t, "BOTAO_LOCAL")

        -- Dispara para a rede
        ac.log(">>> [FCY NET SEND] Disparando pacote de atualizacao para o grid")
        comms({ fcy = novo, timer = t, req = false })
    end

    -- Status com cores brilhantes e legiveis
    ui.dummy(vec2(0, 4))
    if FCY then
        ui.textColored("STATUS: FCY ATIVO (MAX 80)", rgbm(1.0, 0.85, 0.0, 1.0))
    elseif countdownTimer > 0 then
        ui.textColored(string.format("STATUS: EM %d s...", countdownTimer), rgbm(1.0, 0.55, 0.1, 1.0))
    else
        ui.textColored("STATUS: PISTA VERDE", rgbm(0.25, 1.0, 0.35, 1.0))
    end

    ui.endTransparentWindow()
end

-- Loop de fisica e atualizacao
function script.update(dt)
    updateCalls = updateCalls + 1
    ac.debug("FCY_update_Calls", updateCalls)
    ac.debug("FCY_Velocidade", string.format("%.1f km/h", ac.getCar(0).speedKmh))

    -- Controles de administrador via teclado (apenas para quem é admin)
    if isLocalAdmin() then
        -- Alternar visibilidade do painel via F8
        if ui.keyboardButtonDown(ui.Key.F8) then
            showUI = not showUI
            ac.log(">>> [FCY KEY] Tecla F8 pressionada. Painel showUI=" .. tostring(showUI))
        end

        -- Atalho de teclado rápido via F9 (acionar / liberar sem precisar do mouse)
        if ui.keyboardButtonDown(ui.Key.F9) then
            local novo = not FCY
            local t = novo and math.floor(tempoSlider) or 0
            ac.log(string.format(">>> [FCY KEY F9] Tecla F9 pressionada! Mudando para: %s (tempo: %d s)", tostring(novo), t))
            aplicarEstadoFCY(novo, t, "TECLA_F9")
            comms({ fcy = novo, timer = t, req = false })
        end
    end

    -- Contagem regressiva
    if countdownTimer > 0 then
        secondTracker = secondTracker + dt
        if secondTracker >= 1.0 then
            secondTracker = secondTracker - 1.0
            countdownTimer = countdownTimer - 1
            ac.log(string.format(">>> [FCY TIMER TICK] Restam %d segundos", countdownTimer))

            if countdownTimer > 0 then
                ac.playUISound(ac.UISound.Notification)
                ac.setMessage("DIREÇÃO DE PROVA", string.format("FCY EM %d SEGUNDOS", countdownTimer), nil, 1)
            else
                FCY = true
                ac.log(">>> [FCY TIMER] Contagem finalizada! Ativando FCY pleno e limite de 80 km/h")
                ac.playUISound(ac.UISound.FlagCaution)
                ac.setMessage("DIREÇÃO DE PROVA", "FULL COURSE YELLOW ATIVADO", nil, 5)
            end
        end
    end

    -- Regras fisicas e limitador
    if FCY then
        physics.overrideRacingFlag(ac.FlagType.Caution)
        ac.setTurningLights(ac.TurningLights.Hazards)

        local vel = ac.getCar(0).speedKmh
        if vel > 80 then
            physics.forceUserThrottleFor(dt, 0)
            if not logLimiterActive then
                ac.log(string.format(">>> [FCY PHYSICS] Carro acima de 80 km/h (%.1f km/h). Throttle cortado!", vel))
                logLimiterActive = true
            end

            if vel > 85 and physics.getCarInputControls().brake < 0.1 then
                physics.setGentleStop(0, true)
                if not logGentleStopActive then
                    ac.log(string.format(">>> [FCY PHYSICS] Carro acima de 85 km/h (%.1f km/h). Freio automatico acionado!", vel))
                    logGentleStopActive = true
                end
            else
                physics.setGentleStop(0, false)
                logGentleStopActive = false
            end
        else
            physics.setGentleStop(0, false)
            if logLimiterActive then
                ac.log(string.format(">>> [FCY PHYSICS] Carro abaixo de 80 km/h (%.1f km/h). Throttle restaurado.", vel))
                logLimiterActive = false
            end
            logGentleStopActive = false
        end
    else
        logLimiterActive = false
        logGentleStopActive = false
    end
end

-- Requisicao inicial de sincronizacao
ac.log(">>> [FCY INIT] Enviando requisicao de sincronizacao inicial de grid")
comms({ req = true })
