local sim = ac.getSim()
local fcyToggle = ac.ControlButton("FCYTOGGLE")
local FCY = false
local force = false
ac.storageSetPath('woeFCYuponye')
local stor = ac.storage{
    t = 5
}

-- Configurações de corrida
local autoslow = true
local dtLaps = 3
local adminOnly = false -- Mantido false para testes imediatos de acionamento
local altLimiter = false
local windowVisible = true

ac.debug("!version", "woeFCYuponye v1.5 - Kunos ACSM Complete")

ac.onSessionStart(function (sessionIndex, restarted)
    FCY = false
    force = false
end)

-- Sincronização via namespace de pista (não depende de servidor CSP dedicado)
local comms
comms = ac.OnlineEvent({
    ac.StructItem.key("FCY_KUNOS"),
    fcy = ac.StructItem.boolean(),
    time = ac.StructItem.uint8(),
    req = ac.StructItem.boolean()
}, function(sender, message)
    local timer = message.time
    ac.log(string.format("Comms: fcy=%s time=%d req=%s", tostring(message.fcy), message.time, tostring(message.req)))

    if message.req then
        if FCY then
            comms({ fcy = FCY, time = 0, req = false })
        end
    else
        if FCY ~= message.fcy then
            FCY = message.fcy

            setInterval(function()
                if timer > 0 then
                    if FCY then
                        ac.setMessage("FCY", "FCY DEPLOYED IN " .. timer, nil, 5)
                    else
                        ac.setMessage("FCY", "FCY LIFTED IN " .. timer, nil, 5)
                    end
                    timer = timer - 1
                else
                    if FCY then
                        ac.setMessage("FCY", "FCY DEPLOYED", nil, 5)
                    else
                        ac.setMessage("FCY", "FCY LIFTED", nil, 5)
                    end

                    force = FCY
                    return clearInterval
                end
            end, 1, "FCY_TIMER")
        end
    end
end, ac.SharedNamespace.Track)

function castStatus(t)
    math.randomseed(sim.currentSessionTime)
    if not comms(t) then
        setInterval(function ()
            if comms(t) then
                return clearInterval
            end
        end, math.random())
    end
end

-- Botão físico/atalho mapeado no CSP
fcyToggle:onPressed(function ()
    if (adminOnly and sim.isAdmin) or not adminOnly then
        castStatus({ fcy = (not FCY), time = stor.t, req = false })
    end
end)

-- Desenho do painel de controle
local function drawFCYPanel()
    stor.t = ui.slider("Contagem", stor.t, 0, 20, '%.0f seg')
    
    local btnText = FCY and "LIBERAR PISTA (LIFT)" or "ACIONAR FCY (DEPLOY)"
    if ui.button(btnText, vec2(-1, 35)) then
        if (adminOnly and sim.isAdmin) or not adminOnly then
            castStatus({ fcy = (not FCY), time = stor.t, req = false })
        else
            ac.setMessage("FCY", "Apenas administradores podem acionar.", nil, 3)
        end
    end
    
    ui.text(string.format("Status: %s | Admin: %s", FCY and "ATIVO" or "OFF", tostring(sim.isAdmin)))
    fcyToggle:control(vec2(100, 100))
end

-- 1. Registro formal na barra de ferramentas/apps do CSP
ui.registerWindow("Controle FCY", vec2(250, 140), drawFCYPanel)

-- 2. Renderização direta na tela caso o script esteja confinado como Server Script
function script.drawUI()
    if windowVisible then
        ui.begin("Controle FCY", vec2(250, 140))
        drawFCYPanel()
        ui.endTransparentWindow()
    end
end

local wasstop = false
local wasforce = false
local wasFCY = false

function script.update(dt)
    -- Tecla F8 alterna a visibilidade da janela flutuante
    if ui.keyboardButtonDown(ui.KeyIndex.F8) then
        windowVisible = not windowVisible
    end

    local stop = false

    if autoslow then       
        if (car.speedKmh > 85) and force then
            if physics.getCarInputControls().brake < 0.1 then
                stop = true
            end
        elseif car.speedKmh > 79 and force then
            if altLimiter then
                physics.setEngineRPM(0, car.rpm - (100 * (math.max(car.speedKmh - 79, 0))))
            else
                if not car.manualPitsSpeedLimiterEnabled then
                    physics.forceUserThrottleFor(dt, 0)
                end
            end
        end
    end

    if dtLaps > 0 then
        if car.speedKmh > 80.5 and force then
            physics.setCarPenalty(ac.PenaltyType.MandatoryPits, dtLaps)
        end
    end

    if FCY then
        if not wasFCY then
            physics.overrideRacingFlag(ac.FlagType.Caution)  
        end
        ac.setTurningLights(ac.TurningLights.Hazards)
    end

    if not force and wasforce then
        ac.setTurningLights(ac.TurningLights.None)
        physics.overrideRacingFlag(ac.FlagType.None)  
    end

    if stop and not wasstop then
        physics.setGentleStop(0, true)
    end
    if not stop and wasstop then
        physics.setGentleStop(0, false)
    end
    
    wasstop = stop
    wasforce = force
    wasFCY = FCY
end

-- Solicita o estado atual ao entrar na sessão
castStatus({ req = true })