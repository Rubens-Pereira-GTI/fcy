-- ==========================================
-- SCRIPT DE PISTA: FCY (Física e Sincronização)
-- ==========================================

local FCY = false
local force = false
local autoslow = true
local countdownTimer = 0
local secondTracker = 0

-- Receptor de eventos
local comms
comms = ac.OnlineEvent({
    ac.StructItem.key("FCY_KUNOS"),
    fcy = ac.StructItem.boolean(),
    time = ac.StructItem.uint8(),
    req = ac.StructItem.boolean()
}, function(sender, message)
    if message.req then
        if FCY then
            comms({ fcy = true, time = 0, req = false })
        end
        return
    end

    FCY = message.fcy
    local t = message.time or 0

    if FCY then
        if t > 0 then
            countdownTimer = t
            secondTracker = 0
            ac.setMessage("FCY CONTROL", string.format("FCY EM %d SEGUNDOS", t), nil, 1)
        else
            countdownTimer = 0
            force = true
            ac.setMessage("FCY CONTROL", "FULL COURSE YELLOW ATIVADO", nil, 5)
        end
    else
        countdownTimer = 0
        force = false
        physics.overrideRacingFlag(ac.FlagType.None)
        ac.setTurningLights(ac.TurningLights.None)
        ac.setMessage("FCY CONTROL", "PISTA LIBERADA - BANDEIRA VERDE", nil, 4)
    end
end, ac.SharedNamespace.Track)

function script.update(dt)
    -- Contagem regressiva
    if countdownTimer > 0 then
        secondTracker = secondTracker + dt
        if secondTracker >= 1.0 then
            secondTracker = secondTracker - 1.0
            countdownTimer = countdownTimer - 1
            
            if countdownTimer > 0 then
                ac.setMessage("FCY CONTROL", string.format("FCY EM %d SEGUNDOS", countdownTimer), nil, 1)
            else
                force = true
                ac.setMessage("FCY CONTROL", "FULL COURSE YELLOW ATIVADO", nil, 5)
            end
        end
    end

    -- Regras durante o FCY
    if force then
        physics.overrideRacingFlag(ac.FlagType.Caution)
        ac.setTurningLights(ac.TurningLights.Hazards)

        -- Limitador a 80 km/h
        if autoslow and car.speedKmh > 80 then
            physics.forceUserThrottleFor(dt, 0)
            if car.speedKmh > 85 and physics.getCarInputControls().brake < 0.1 then
                physics.setGentleStop(0, true)
            else
                physics.setGentleStop(0, false)
            end
        else
            physics.setGentleStop(0, false)
        end
    end
end

-- Solicita estado ao entrar
comms({ req = true })