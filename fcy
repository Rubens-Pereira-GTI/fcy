-- REGISTRO DE JANELA DO CSP
local windowVisible = true

local function drawFCYPanel()
    stor.t = ui.slider("Contagem", stor.t, 0, 20, '%.0f seg')
    
    if ui.button(FCY and "LIBERAR PISTA (LIFT)" or "ACIONAR FCY (DEPLOY)", vec2(-1, 35)) then
        castStatus({ fcy = (not FCY), time = stor.t, req = false })
    end
    
    ui.text(string.format("Status: %s | Admin: %s", FCY and "ATIVO" or "OFF", tostring(sim.isAdmin)))
    fcyToggle:control(vec2(100, 100))
end

-- Registra a janela no ecossistema do CSP
ui.registerWindow("Controle FCY", vec2(250, 130), drawFCYPanel)

